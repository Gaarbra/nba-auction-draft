www.{$DOMAIN} {
  redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin-when-cross-origin
    Strict-Transport-Security "max-age=31536000"
  }
  @appMetadata path /hoopbids/sw.js /hoopbids/manifest.webmanifest
  header @appMetadata Cache-Control "no-cache"
  @backend path /api/* /socket.io/* /health
  handle @backend {
    reverse_proxy server:4000
  }
  redir /hoopbids /hoopbids/ 308
  handle /hoopbids/* {
    root * /srv
    try_files {path} /hoopbids/index.html
    file_server
  }
  handle {
    root * /srv
    file_server
  }
}
