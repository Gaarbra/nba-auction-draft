PORT=4000
CLIENT_ORIGIN=http://localhost:5173
STATS_SERVICE_URL=http://127.0.0.1:5001

# Optional. Enables persisting completed drafts (see db/schema.sql and
# src/services/db.js). Leave unset and the app works exactly the same
# without a database at all.
# DATABASE_URL=postgresql://user:password@localhost:5432/hoop_bids
#
# Pointed at AWS RDS instead of local/Render Postgres, it looks like:
# DATABASE_URL=postgresql://<master-username>:<master-password>@<rds-endpoint>:5432/hoop_bids
# (the endpoint and port come from the RDS console's "Connectivity & security"
# tab once the instance is available; see AWS_MIGRATION.md for the full walkthrough)

# Required alongside DATABASE_URL once it points at RDS (reached over the
# public internet, unlike Render's own internal Postgres connection, which
# doesn't need this). Leave unset for local Postgres or Render's own DB.
# DATABASE_SSL=require

# Production only. NODE_ENV=production also enables trust-proxy handling for
# per-IP rate limiting behind a hosting platform's reverse proxy.
# NODE_ENV=production

# Optional. If set, POST /api/players/sync (forces a full nba_api resync)
# requires this value in an X-Admin-Token header, and 404s for anyone else.
# Leave unset for local dev, set it before exposing the server publicly.
# ADMIN_TOKEN=
