PORT=4000
CLIENT_ORIGIN=http://localhost:5173
STATS_SERVICE_URL=http://127.0.0.1:5001

# Optional. Enables persisting completed drafts (see db/schema.sql and
# src/services/db.js). Leave unset and the app works exactly the same
# without a database at all.
# DATABASE_URL=postgresql://user:password@localhost:5432/hoop_bids
# Production Docker configuration is in ../.env.example and ../SERVERCHEAP.md.
# Enable TLS when using an external PostgreSQL host that requires it.
# DATABASE_SSL=require

# Production requires real Turnstile keys (client site key + server secret).
# NODE_ENV=production
# TURNSTILE_SECRET_KEY=
# Only set when the server is reachable exclusively through ONE trusted proxy.
# TRUST_PROXY=1
# The admin sync endpoint is disabled unless this is set.
# ADMIN_TOKEN=
