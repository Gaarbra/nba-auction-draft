# Docker Compose production settings. Copy to .env; never commit real secrets.
DOMAIN=girma.me
# Public browser/Socket.IO origin is https://${DOMAIN}; Vite receives it at build time.
# Internal routing stays on Docker DNS. Never use this URL in the browser.
STATS_SERVICE_URL=http://stats:5001
# Copy your gateway credentials from DataImpulse. This is NOT http://dataimpulse.com.
# Percent-encode special characters in username/password; keep single quotes.
PROXY_URL='http://REPLACE_LOGIN:REPLACE_PASSWORD@gw.dataimpulse.com:823'
NO_PROXY=localhost,127.0.0.1,::1,web,server,stats,db,169.254.169.254
# Register girma.me in the Turnstile widget's allowed hostnames.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Generate a hex password, e.g. openssl rand -hex 32 (safe inside the DB URL).
POSTGRES_PASSWORD=
# DATABASE_URL is composed internally from this password in compose.yaml:
# postgresql://hoop:<POSTGRES_PASSWORD>@db:5432/hoop_bids
# Leave blank to disable the expensive admin sync endpoint.
ADMIN_TOKEN=
# One sequential maintenance worker; caps are starting points, measure on the VPS.
REFRESH_CPUS=0.5
REFRESH_MEMORY_LIMIT=1g
REFRESH_MAX_RUNTIME_SECONDS=1200
REFRESH_AWARDS_MAX_RUNTIME_SECONDS=600
