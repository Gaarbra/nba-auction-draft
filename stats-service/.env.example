# Optional. Enables persisting player/season reference data to Postgres
# (see ../db/schema.sql and db.py). Leave unset and the app works exactly
# the same without a database at all.
# DATABASE_URL=postgresql://user:password@localhost:5432/hoop_bids
#
# Pointed at AWS RDS instead of local/Render Postgres, it looks like:
# DATABASE_URL=postgresql://<master-username>:<master-password>@<rds-endpoint>:5432/hoop_bids
# (see ../AWS_MIGRATION.md for the full walkthrough)

# Required alongside DATABASE_URL once it points at RDS (reached over the
# public internet, unlike Render's own internal Postgres connection, which
# doesn't need this). Leave unset for local Postgres or Render's own DB.
# DATABASE_SSL=require

# Optional (Phase 2 of ../AWS_MIGRATION.md). Enables archiving every raw
# stats.nba.com API response to S3, unprocessed, for whatever a future
# model might want that today's parsing doesn't capture. Leave unset and
# the app works exactly the same without it -- archiving silently no-ops.
# S3_RAW_ARCHIVE_BUCKET=hoop-bids-raw-nba-data
# AWS_REGION=us-east-1
#
# Credentials for the bucket above -- an IAM user scoped to just
# s3:PutObject on this one bucket (see ../AWS_MIGRATION.md), not your AWS
# account's root keys. Never commit real values here.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
